{
  "C_Cpp.default.includePath": [
    "${workspaceFolder}/kernel",
    "${workspaceFolder}/drivers/display",
    "${workspaceFolder}/filesystem"
  ],
  "files.exclude": {
    "**/.git": true,
    "build/obj/**": true,
    "build/iso-root/**": true
  },
  "files.associations": {
    "*.asm": "nasm",
    "Makefile": "makefile"
  },
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true
}
